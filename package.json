    "expo-dev-client": "~6.0.0",
    "expo-font": "~14.0.0",
    "expo-linking": "~8.0.0",
    "expo-network": "^55.0.13",
    "expo-notifications": "~0.32.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
