  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "setup:android": "node -e \"const os=require('os'),fs=require('fs'),p=require('path');const sdk=p.join(os.homedir(),'Library/Android/sdk');fs.writeFileSync('android/local.properties','sdk.dir='+sdk+'\\n');console.log('local.properties written. sdk.dir:',sdk);\""
  },
